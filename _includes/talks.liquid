<div class="news">
  {% if site.talks != blank %}
    <div class="table-responsive">
      <table class="table table-sm table-borderless">
        {% assign talks = site.talks | sort: 'date' | reverse %}
        {% for item in talks %}
          <tr>
            <th scope="row" style="width: 20%">{{ item.date | date: '%b %d, %Y' }}</th>
            <td>
              {{ item.content | remove: '<p>' | remove: '</p>' | emojify }}
            </td>
          </tr>
        {% endfor %}
      </table>
    </div>
  {% else %}
    <p>No talks so far...</p>
  {% endif %}
</div>
